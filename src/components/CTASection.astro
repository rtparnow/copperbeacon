---
interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Ready to let the customers find you?',
  body = 'Fifteen minutes. No pitch. Just a real conversation about whether we can help.',
  ctaLabel = 'Book a free 15-minute call',
  ctaHref = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ0yajrOkLo_qJWOzoxfXEl_qIuIg3fc8INjtzqY464KpTTTH9ljqyYkmbNNn9-_xdV-V_vsMkks?gv=true',
} = Astro.props;
---

<section class="relative bg-navy py-20 overflow-hidden" aria-labelledby="cta-heading">
  <img
    src="/logo.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none select-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-[0.06]"
    style="width: min(70vw, 640px); height: auto;"
  />
  <div class="container text-center relative z-10">
    <h2 id="cta-heading" class="font-serif font-medium text-cream mb-4" style="font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.2;">
      {heading}
    </h2>
    <p class="font-sans text-cream/70 text-lg max-w-md mx-auto mb-8">
      {body}
    </p>
    <a href={ctaHref} class="btn-primary-reversed">
      {ctaLabel}
    </a>
  </div>
</section>
